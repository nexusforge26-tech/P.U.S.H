# ============================================
# PUSH - Palestine University Students Hub
# متغيرات البيئة المطلوبة
# ============================================

# من لوحة تحكم Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# مفتاح service_role (سري جدًا! لا تضعه أبدًا في كود يعمل على المتصفح)
# يُستخدم فقط داخل مسارات API على السيرفر (app/api/admin/*) لإضافة/تعديل المحتوى
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ============================================
# رفع الملفات إلى Google Drive الخاص بالموقع
# ============================================
# عند إضافة مادة (ملخص/امتحان/ملف)، يرفع المستخدم الملف مباشرة من جهازه ويتم
# تخزينه في Google Drive تابع لحساب الموقع (وليس حساب المستخدم الشخصي).
#
# خطوات الإعداد:
# 1) في Google Cloud Console: أنشئ مشروعًا، وفعّل "Google Drive API".
# 2) أنشئ "Service Account" (حساب خدمة)، ثم أنشئ له مفتاح JSON وحمّله.
# 3) من ملف الـ JSON خذ القيمتين client_email و private_key وضعهما أدناه.
# 4) في Google Drive العادي (حساب الموقع)، أنشئ مجلدًا مخصصًا للمرفقات وشارِكه
#    مع بريد حساب الخدمة (client_email) بصلاحية "محرر / Editor"، ثم انسخ
#    معرّف المجلد من رابطه وضعه في GOOGLE_DRIVE_FOLDER_ID.
GOOGLE_SERVICE_ACCOUNT_EMAIL=push-uploader@your-project.iam.gserviceaccount.com
# انسخ private_key كاملًا كما هو من ملف JSON (بما فيه أسطر \n)
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_FOLDER_ID=1AbCDEfGhIjKlMnOpQrStUvWxYz
