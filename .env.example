# ============================================
# PUSH - Palestine University Students Hub
# متغيرات البيئة المطلوبة
# ============================================

# من لوحة تحكم Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# مفتاح service_role (سري جدًا! لا تضعه أبدًا في كود يعمل على المتصفح)
# يُستخدم فقط داخل مسارات API على السيرفر لإدارة المحتوى والمراجعات
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# بريد مالك الموقع الأساسي (أو عدة عناوين مفصولة بفاصلة)
# يُمنح هذا البريد صلاحية owner تلقائيًا ولا يمكن خفض صلاحيته أو حذفه
OWNER_EMAIL=your-owner-email@example.com

# رابط الموقع العام (يُستخدم في sitemap.xml و robots.txt ومعاينات المشاركة OpenGraph)
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# ============================================
# رفع الملفات إلى Google Drive الخاص بالموقع
# ============================================
# المجلد القديم (مرجع للقراءة/الإدارة والملفات القديمة؛ لا تُرفع إليه ملفات جديدة)
GOOGLE_DRIVE_FOLDER_ID=1AbCDEfGhIjKlMnOpQrStUvWxYz
# مجلد جديد يملكه حساب OAuth (أنشئه وسجّل معرّفه هنا)
GOOGLE_DRIVE_UPLOAD_FOLDER_ID=

# ---------------------------------------------------------------
# OAuth 2.0 بصلاحية drive.file لإنشاء الملفات الجديدة داخل المجلد الذي أنشأه تطبيق OAuth
# يملك حساب Google العادي مساحة التخزين، أما حساب الخدمة فلا يملك حصة شخصية ولا يملك الملفات.
# يمكنه قراءة/إدارة مجلد My Drive عند مشاركته معه بصلاحية Editor؛ لا يلزم Shared Drive لهذا النمط.
# 1) في Google Cloud Console: أنشئ OAuth Client ID وتأكد من تفعيل Google Drive API.
# 2) امنح OAuth scope https://www.googleapis.com/auth/drive.file (لا تستخدم full drive scope).
# 3) أنشئ مجلد الرفع الجديد بحساب OAuth والتقط معرّفه. شارك هذا المجلد مع
#    GOOGLE_SERVICE_ACCOUNT_EMAIL بصلاحية Editor حتى يقرأ/يتحقق/يدير الملفات الجديدة.
# 4) احصل على Refresh Token باستخدام OAuth Client ID/Secret الخاصة بك ثم ضع القيم أدناه:
# ---------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# ---------------------------------------------------------------
# حساب الخدمة يبقى الافتراضي للقراءة والتنزيل والإدارة القديمة. عند توافر الاثنين،
# تُستخدم الخدمة لهذه العمليات وOAuth للرفع الجديد. خدمة الحساب ليست مالك الرفع ولا تُقاس حصتها.
# ---------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# ============================================
# واتساب + Gemini (اختياري — يُعطَّل الويب هوك تلقائيًا بدون الأسرار)
# ============================================
# رمز التحقق عند ربط الويب هوك مع Meta (اخترْ قيمة عشوائية طويلة؛ لا توجد قيمة افتراضية)
WHATSAPP_VERIFY_TOKEN=
# App Secret من تطبيق Meta: يُستعمل للتحقق من توقيع كل رسالة واردة (X-Hub-Signature-256)
WHATSAPP_APP_SECRET=
# سر مشترك لاستدعاءات n8n/Make المباشرة (أرسله في Authorization: Bearer ... أو x-bot-secret)
WHATSAPP_BOT_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
