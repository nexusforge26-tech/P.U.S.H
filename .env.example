# ============================================
# PUSH - Palestine University Students Hub
# متغيرات البيئة المطلوبة
# ============================================

# من لوحة تحكم Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# مفتاح service_role (سري جدًا! لا تضعه أبدًا في كود يعمل على المتصفح)
# يُستخدم فقط داخل مسارات API على السيرفر لإدارة المحتوى والمراجعات
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# بريد مالك الموقع الأساسي (أو عدة عناوين مفصولة بفاصلة)
# يُمنح هذا البريد صلاحية owner تلقائيًا ولا يمكن خفض صلاحيته أو حذفه
OWNER_EMAIL=your-owner-email@example.com

# رابط الموقع العام (يُستخدم في sitemap.xml و robots.txt ومعاينات المشاركة OpenGraph)
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# ============================================
# رفع الملفات إلى Google Drive الخاص بالموقع
# ============================================
# معرّف مجلد Google Drive المخصص لحفظ ملفات الموقع:
GOOGLE_DRIVE_FOLDER_ID=1AbCDEfGhIjKlMnOpQrStUvWxYz

# ---------------------------------------------------------------
# الطريقة الموصى بها (مع حساب Google Drive شخصي عادي): OAuth 2.0
# حساب الخدمة (Service Account) لا يملك مساحة تخزين شخصية ولا يعمل إلا مع
# Google Workspace Shared Drives المدفوعة؛ لذلك استخدم OAuth لحساب Google عادي:
# 1) في Google Cloud Console: أنشئ OAuth Client ID وتأكد من تفعيل Google Drive API.
# 2) احصل على Refresh Token بصلاحية https://www.googleapis.com/auth/drive
#    (مثلًا عبر OAuth 2.0 Playground باستخدام بيانات Client ID/Secret الخاصة بك).
# 3) ضع القيم الثلاث أدناه:
# ---------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# ---------------------------------------------------------------
# بديل متقدم (يعمل فقط مع Google Workspace Shared Drive وليس مجلدًا شخصيًا):
# إذا لم تُضبط متغيرات OAuth أعلاه، يتم استخدام Service Account:
# ---------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# ============================================
# واتساب + Gemini (اختياري — يُعطَّل الويب هوك تلقائيًا بدون الأسرار)
# ============================================
# رمز التحقق عند ربط الويب هوك مع Meta (اخترْ قيمة عشوائية طويلة؛ لا توجد قيمة افتراضية)
WHATSAPP_VERIFY_TOKEN=
# App Secret من تطبيق Meta: يُستعمل للتحقق من توقيع كل رسالة واردة (X-Hub-Signature-256)
WHATSAPP_APP_SECRET=
# سر مشترك لاستدعاءات n8n/Make المباشرة (أرسله في Authorization: Bearer ... أو x-bot-secret)
WHATSAPP_BOT_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
